# Copy to .env for local dev — docker-compose.yml owns these values
DATABASE_URL=postgres://fuel:fuel@localhost:5433/fuel

# Overview generation — server-side Bedrock/DB timing logs (console.info).
# 1|true|on = always on · 0|false|off = always off · unset = on in non-production
OVERVIEW_PERF_LOG=

# Overview generation — log full Bedrock prompt/payload before Converse (console.info).
# Same flag semantics as OVERVIEW_PERF_LOG. When unset, follows OVERVIEW_PERF_LOG if set.
# Emails/tokens are redacted. Never returned to the frontend.
OVERVIEW_PROMPT_LOG=

# Marker.io — leave empty locally to disable the feedback widget.
# Deployed: CDK injects from FUEL2_MARKER_IO_PROJECT_ID → MARKER_IO_PROJECT_ID.
# Project key from Marker dashboard → Widget → Installation (public client id).
MARKER_IO_PROJECT_ID=

# Sentry — leave DSN empty locally to disable reporting
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Set to "true" to send events from localhost (optional)
SENTRY_ENABLE_IN_DEV=

# Public API — machine auth for /api/public/v1/* (Basic or X-Client-Id/Secret)
# Local: set both below. Leave empty → routes return 503 public_api_not_configured.
# Deployed: CDK injects from Secrets Manager fuel2-<stage>-public-api
#   JSON { "clientId", "clientSecret" } → PUBLIC_API_CLIENT_ID / PUBLIC_API_CLIENT_SECRET
PUBLIC_API_CLIENT_ID=
PUBLIC_API_CLIENT_SECRET=

# Onboard: unlock review without waiting for Crunchbase/Bright Data when
# required profile fields are available from Fuel data / website / LLM.
# 1|true|on = enabled · unset/0/false = legacy unlock on crunchbase_ready.
ONBOARD_UNLOCK_WITHOUT_CRUNCHBASE=

# Bright Data — local: BRIGHTDATA_API_KEY. Deployed: BRIGHTDATA_SECRET_ARN
#   fuel2-<stage>-brightdata-api  JSON { "apiKey" }
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_SECRET_ARN=

# Stripe — credits & pricing (F20A-104)
# Local: set STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET below.
# Deployed: CDK sets STRIPE_SECRET_ARN → Secrets Manager
#   fuel2-<stage>-stripe-api  JSON { "secretKey", "webhookSecret" }
# Use Price ids (price_…), not Product ids (prod_…). Env overrides DB when set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_ARN=   # set by CDK on Lambda; not needed locally
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_TOPUP_SPRINT_PRICE_ID=
STRIPE_TOPUP_BUILDER_PRICE_ID=
STRIPE_TOPUP_GROWTH_PRICE_ID=
STRIPE_TOPUP_SCALE_PRICE_ID=

# Fuel 1.0 → 2.0 watchlist migration (onboarding claim). Deployed: CDK sets
# WATCHLIST_MIGRATION_FN_NAME on the web Lambda. Leave empty locally → no-op.
WATCHLIST_MIGRATION_FN_NAME=
